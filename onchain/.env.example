# ─── Moonball on-chain config ───────────────────────────────────────────
# Copy to onchain/.env and fill in. NEVER commit the real .env.

# Public deployer address for read-only preflight; no private key is required.
# Address-only checks do not prove key control or readiness to sign.
# DEPLOYER_ADDRESS=0x...
# Keep private keys out of OneDrive/cloud-synced directories, even if Git ignored.

# Deployer key (must be funded with native ETH on the target network).
# DEPLOYER_PRIVATE_KEY is used for deploy/transfer; PRIVATE_KEY is used by the
# bridge keeper. Prefer the guarded hidden-prompt scripts for both roles; never
# save either key in this file while the checkout is in a synced directory.
# DEPLOYER_PRIVATE_KEY=0x...   # needed only for signing, not address-only preflight
# PRIVATE_KEY=0x...            # bridge keeper key (defaults to DEPLOYER_PRIVATE_KEY if unset)

# RPC endpoints. RPC_URL is a shared fallback; the per-network vars win.
# Base Sepolia has a public default (https://sepolia.base.org) so this is optional.
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org
# RPC_URL=

# Optional Etherscan V2 API key for BaseScan source publication. Sourcify and
# Base Sepolia Blockscout verification do not require a key. Keep real API keys
# only in local process state or a non-synced secret store, never this template.
# ETHERSCAN_API_KEY=

# ─── Deploy options (scripts/deploy.ts) ─────────────────────────────────
# DEX pair (quote) token for the MOON/USDC pool. Leave unset only on hardhat or
# localhost to deploy MockUSDC. Public networks require the official address.
# This points the dashboard at the pair token; it is not protocol collateral.
# Base Sepolia USDC (Circle):  0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet  USDC (Circle): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Oracle updater / bridge keeper. Required on public networks and separate from
# SAFE_ADDRESS. Local networks default to the deployer.
# UPDATER_ADDRESS=0x...
# ORACLE_STALENESS=14400        # source-age limit, 300-86400 seconds (default 4h)

# Exactly 100,000,000 MOON is hardcoded and minted once to SUPPLY_RECIPIENT.
# SUPPLY_RECIPIENT is required on public networks and must equal SAFE_ADDRESS
# on Base mainnet. Local networks default to the deployer.
# SUPPLY_RECIPIENT=0x...        # receives the fixed 100M supply

# Moonball 2-of-3 Safe. Required and contract-validated on Base mainnet. When
# supplied on a public network, deploy.ts validates it and installs it as oracle
# owner at genesis (no one-step post-deploy handoff).
# SAFE_ADDRESS=0xSafe...

# Optional localhost/hardhat seed only. Public networks reject this setting and
# require publication through the verified bridge.
# SEED_JACKPOT_M=225

# ─── Founder / investor vesting (scripts/deploy-vesting.ts) ─────────────
# Locks the founder (20%) + investor (15%) MOON in on-chain vesting wallets.
# Run from the treasury / SUPPLY_RECIPIENT wallet (the MOON holder).
# VESTING_START=                 # unix seconds; defaults to deploy time (now)
#
# Founder: 1yr cliff / 4yr linear vest, 20M MOON.
# FOUNDER_ADDRESS=0x...          # required to lock the founder bucket
# FOUNDER_AMOUNT=20000000        # whole MOON (default 20M = 20%)
# FOUNDER_CLIFF_DAYS=365         # 1 year
# FOUNDER_VEST_DAYS=1460         # 4 years
#
# Investors: per term sheet (default 6mo cliff / 2yr vest), 15M MOON total.
# INVESTOR_ADDRESSES=0x...,0x... # comma-separated; required to lock investors
# INVESTOR_AMOUNTS=...           # comma-separated whole MOON per address
#                                # (omit to split INVESTOR_TOTAL evenly)
# INVESTOR_TOTAL=15000000        # whole MOON across all investors (default 15M)
# INVESTOR_CLIFF_DAYS=180        # 6 months
# INVESTOR_VEST_DAYS=730         # 2 years
# DRY_RUN=1                      # validate balances + print plan, send nothing

# ─── Ownership transfer (scripts/transfer-ownership.ts) ─────────────────
# Only the oracle has an owner; the token is immutable and ownerless. Use this
# script for a testnet deployment that did not set SAFE_ADDRESS during deploy.

# ─── Bridge keeper (scripts/bridge.ts) ──────────────────────────────────
# ORACLE_ADDRESS=0x...          # defaults to deployments/<NETWORK>.json
# NETWORK=baseSepolia           # which deployments file to read
# DASHBOARD_URL=https://your-dashboard.example  # HTTPS required except loopback
# Public-network bridge sends also require EXPECTED_SNAPSHOT_ID and
# EXPECTED_SEQUENCE from the reviewed no-key preflight. Use the guarded Windows
# publisher instead of persisting those approval values here.
# POLL_SECONDS=300              # daemon interval; ONCE=1 for a single run
# RETRY_ATTEMPTS=3              # bounded attempts per run/cycle (1-10)
# RETRY_DELAY_MS=2000           # delay between attempts (0-60000)
