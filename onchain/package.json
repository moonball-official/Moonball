{
  "name": "moonball-onchain",
  "version": "1.0.0",
  "description": "Moonball smart contract suite (DEX event market) — isolated Hardhat project",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "preflight": "hardhat run scripts/preflight.ts",
    "preflight:signer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preflight-with-key.ps1",
    "deploy:base-sepolia:interactive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-base-sepolia-with-key.ps1",
    "recover:base-sepolia": "hardhat run scripts/recover-base-sepolia.ts",
    "recover:base-sepolia:interactive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recover-base-sepolia-with-key.ps1",
    "verify:sources:base-sepolia": "hardhat run scripts/verify-sources.ts --network baseSepolia",
    "verify:sources:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-base-sepolia-sources.ps1",
    "rehearsal:dashboard": "ts-node scripts/dev/rehearsal-dashboard.ts",
    "verify:deployment": "hardhat run scripts/verify-deployment.ts",
    "deploy": "hardhat run scripts/deploy.ts",
    "node": "hardhat node",
    "bridge": "hardhat run scripts/bridge.ts",
    "bridge:base-sepolia:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bridge-base-sepolia-preflight.ps1",
    "bridge:base-sepolia:interactive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-base-sepolia-snapshot-with-key.ps1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.5"
  }
}
